{
  "region": "us-east-1",
  "serviceRoleName": "humorus-cloudformation",
  "pipelineCheck": false,
  "root": ".",
  "stacks": [
    {
      "name": "humorus-github-deploy",
      "template": "papyrus:infra/account/baseline.yaml",
      "group": "roles",
      "serviceRoleName": "humorus-cloudformation-roles",
      "capabilities": [
        "CAPABILITY_NAMED_IAM"
      ],
      "enabled": true,
      "parameters": {
        "Prefix": "humorus",
        "GithubRepository": "AnthusAI/Humorus",
        "GithubSubjectPrefix": "repo:AnthusAI@152415604/Humorus@1454269356",
        "ProductionBranch": "main",
        "AmplifyAppId": "*",
        "CreateOidcProvider": "true",
        "ApprovalEnvironment": "pipeline-roles",
        "BudgetName": "papyrus-production-monthly"
      }
    },
    {
      "name": "humorus-dns",
      "template": "papyrus:infra/account/stacks/dns.yaml",
      "enabled": true,
      "parameters": {
        "DomainName": "thehallucinator.ai",
        "ZoneComment": "Humorus: TheHallucinator.ai"
      },
      "import": {
        "logicalId": "HostedZone",
        "resourceType": "AWS::Route53::HostedZone",
        "lookup": {
          "kind": "hostedZoneByName",
          "name": "thehallucinator.ai"
        },
        "identifierKey": "Id"
      },
      "checks": [
        {
          "kind": "nameservers",
          "zone": "thehallucinator.ai",
          "expectedFile": "expected-nameservers.json"
        }
      ]
    },
    {
      "name": "humorus-budget",
      "template": "papyrus:infra/account/stacks/budget.yaml",
      "enabled": true,
      "parameters": {
        "BudgetName": "papyrus-production-monthly",
        "MonthlyLimitUsd": "200",
        "AlertEmail": "/humorus/budget-alert-email"
      },
      "import": {
        "logicalId": "MonthlyBudget",
        "resourceType": "AWS::Budgets::Budget",
        "lookup": {
          "kind": "budgetByName",
          "name": "papyrus-production-monthly"
        },
        "identifierKey": "Id"
      }
    },
    {
      "name": "humorus-certificate",
      "template": "papyrus:infra/account/stacks/certificate.yaml",
      "enabled": true,
      "when": {
        "delegated": {
          "zone": "thehallucinator.ai",
          "expectedFile": "expected-nameservers.json"
        }
      },
      "parameters": {
        "DomainName": "thehallucinator.ai",
        "HostedZoneId": {
          "fromStackOutput": {
            "stack": "humorus-dns",
            "output": "HostedZoneId"
          }
        }
      }
    },
    {
      "name": "humorus-ses",
      "template": "papyrus:infra/account/stacks/ses.yaml",
      "enabled": true,
      "parameters": {
        "DomainName": "thehallucinator.ai",
        "HostedZoneId": {
          "fromStackOutput": {
            "stack": "humorus-dns",
            "output": "HostedZoneId"
          }
        },
        "MailFromSubdomain": "mail",
        "DmarcPolicy": "none"
      }
    },
    {
      "name": "humorus-placeholder",
      "template": "papyrus:infra/account/stacks/placeholder.yaml",
      "enabled": true,
      "when": {
        "delegated": {
          "zone": "thehallucinator.ai",
          "expectedFile": "expected-nameservers.json"
        }
      },
      "parameters": {
        "DomainName": "thehallucinator.ai",
        "HostedZoneId": {
          "fromStackOutput": {
            "stack": "humorus-dns",
            "output": "HostedZoneId"
          }
        },
        "CertificateArn": {
          "fromStackOutput": {
            "stack": "humorus-certificate",
            "output": "CertificateArn"
          }
        },
        "SiteName": "TheHallucinator.ai",
        "Label": "Satire: everything on this site is invented, and none of it is news.",
        "Message": "The first stories are on their way."
      }
    }
  ]
}
